            "nullable": true
          },
          "existing_heating_type": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "example": "Gas furnace"
          },
          "device_serial": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "example": "SN-123456789"
          },
          "louvered_sides": {
            "type": "boolean",
            "nullable": true
          },
          "contractor_fax": {
            "type": "string",
            "nullable": true
          },
          "coil_make_model": {
            "type": "string",
            "nullable": true
          },
          "added_by": {
            "type": "string",
            "enum": [
              "organization",
              "customer"
            ],
            "example": "organization"
          },
          "device": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-10 12:00:00+00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-15 14:30:00+00:00"
          },
          "final_inspection_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-04-18"
          },
          "invoice_number": {
            "type": "string",
            "nullable": true,
            "example": "INV-2026-0042"
          },
          "pto_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-03-02"
          }
        }
      },
      "LegacyApplication": {
        "description": "One application: the customer's claim on one program. Additional fields can appear as Leap adds them, so ignore keys you don't recognize.",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "dismissal_reason": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Why the application was dismissed. Null unless `status` is `dismissed`. Partner responses currently omit this field, pending a ruling."
          },
          "rejection_reason": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Why the program rejected the application, when Leap recorded a reason. Partner responses currently omit this field, pending a ruling."
          },
          "connect_completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "readOnly": true
          },
          "id": {
            "type": "integer",
            "example": 123
          },
          "application_uuid": {
            "type": "string",
            "format": "uuid",
            "example": "6f1d1f1e-0a2b-4c3d-8e9f-000000000b1a"
          },
          "program_id": {
            "type": "integer",
            "example": 339
          },
          "program_name": {
            "type": "string",
            "nullable": true,
            "example": "SGIP Storage"
          },
          "customer_id": {
            "type": "integer",
            "example": 609
          },
          "reference_id": {
            "type": "string",
            "nullable": true,
            "example": "external-ref-123"
          },
          "customer_device_id": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              45,
              46
            ],
            "nullable": true
          },
          "rebate_type": {
            "type": "string",
            "nullable": true,
            "example": "instant"
          },
          "payee_type": {
            "type": "string",
            "enum": [
              "customer",
              "contractor",
              "instant",
              "aggregator",
              "oem"
            ],
            "nullable": true,
            "example": "customer"
          },
          "submission_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2025-01-15"
          },
          "confirmation_number": {
            "type": "string",
            "nullable": true,
            "example": "GP-339-000001"
          },
          "approval_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2025-01-20"
          },
          "total_requested_amount": {
            "type": "number",
            "format": "decimal",
            "nullable": true,
            "example": 150
          },
          "upfront_amount": {
            "type": "number",
            "format": "decimal",
            "nullable": true,
            "example": 0
          },
          "install_amount": {
            "type": "number",
            "format": "decimal",
            "nullable": true,
            "example": 150
          },
          "ongoing_amount": {
            "type": "number",
            "format": "decimal",
            "nullable": true,
            "example": 0
          },
          "agree_terms": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "customer_signature": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "customer_sig_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2025-01-15"
          },
          "contractor_signature": {
            "type": "boolean",
            "nullable": true,
            "example": false
          },
          "contractor_sig_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "project_name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "example": "EV Charger Installation"
          },
          "eligibility_category": {
            "type": "string",
            "enum": [
              "1A",
              "1B",
              "1C",
              "2"
            ],
            "nullable": true
          },
          "income_backup_onfile": {
            "type": "boolean",
            "default": false
          },
          "neat_sir_verified": {
            "type": "boolean",
            "nullable": true
          },
          "proposed_measures": {
            "type": "object",
            "nullable": true
          },
          "prepay_amount": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "authorize_contractor": {
            "type": "boolean",
            "default": false
          },
          "authorize_payee": {
            "type": "boolean",
            "default": false
          },
          "utility_account_attestation": {
            "type": "boolean",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/LegacyApplicationStatus"
          },
          "equipment_complete": {
            "type": "boolean",
            "nullable": true
          },
          "permit_complete": {
            "type": "boolean",
            "nullable": true
          },
          "utility_complete": {
            "type": "boolean",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-10 15:30:00+00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-15 10:45:00+00:00"
          },
          "sub_programs": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "ev_charging_participation_attestation": {
            "type": "boolean",
            "nullable": true
          },
          "co_enrollment_attestation": {
            "type": "boolean",
            "nullable": true
          },
          "agreements_accepted": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "reopened_reason": {
            "type": "string",
            "nullable": true
          },
          "dispatch_option": {
            "type": "string",
            "nullable": true
          },
          "cbl_method": {
            "type": "string",
            "nullable": true
          },
          "partner_offering_name": {
            "type": "string",
            "nullable": true
          },
          "partner_offering_date": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LegacyApplicationSearchResponse": {
        "description": "One customer's applications, with your organization, the customer, and the customer's devices. Follow `next_page_token` until it's null to read every page of `applications`.",
        "type": "object",
        "properties": {
          "next_page_token": {
            "type": "string",
            "nullable": true,
            "example": "eyJsYXN0X2lkIjo0ODIxM30="
          },
          "organization": {
            "$ref": "#/components/schemas/LegacyOrganizationRef"
          },
          "customer": {
            "$ref": "#/components/schemas/LegacyCustomer"
          },
          "customer_devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegacyCustomerDevice"
            },
            "description": "The customer's devices. Each `id` is the value you send in `customer_devices[].id` on **Update application**."
          },
          "applications": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/LegacyApplication"
                },
                {
                  "type": "object",
                  "properties": {
                    "program_slug": {
                      "type": "string",
                      "nullable": true,
                      "example": "georgia_power_heip_residential_level_2_ev_charger_rebate"
                    }
                  }
                }
              ]
            },
            "description": "The customer's applications on this page, one per program."
          }
        }
      },
      "ContractLegacyError": {
        "description": "An error. `code` is a stable identifier you can branch on, `message` explains it, and `requestId` identifies the request for Leap support.",
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "ambiguous_reference_id"
          },
          "message": {
            "type": "string",
            "example": "refId is shared by more than one organization"
          },
          "details": {
            "nullable": true,
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string",
            "example": "78b7cad5-ab45-44af-9c1e-2f0a1b2c3d4e"
          }
        }
      },
      "LegacyApplicationDetail": {
        "description": "One application with its customer, the customer's devices, and its status history.",
        "allOf": [
          {
            "$ref": "#/components/schemas/LegacyApplication"
          },
          {
            "type": "object",
            "properties": {
              "program_slug": {
                "type": "string",
                "nullable": true
              },
              "customer": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/LegacyCustomer"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "customer_devices": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/LegacyCustomerDevice"
                        }
                      }
                    }
                  }
                ]
              },
              "status_history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "The history entry's ID. Treat it as opaque: most entries return a UUID string, and some return an integer.",
                      "oneOf": [
                        {
                          "type": "string",
                          "format": "uuid"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "example": "3f2b8c1e-4d5a-4b6c-9e7f-8a9b0c1d2e3f"
                    },
                    "from_status": {
                      "type": "string",
                      "nullable": true
                    },
                    "to_status": {
                      "type": "string"
                    },
                    "changed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "changed_by": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "LegacyEnvelope": {
        "description": "`ok` is true on success. `requestId` identifies the request for Leap support.",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "requestId": {
            "type": "string",
            "example": "78b7cad5-ab45-44af-9c1e-2f0a1b2c3d4e"
          }
        }
      },
      "LegacyMutations": {
        "description": "What the request changed: the fields written to the customer and to each device. Leap ignores keys it doesn't recognize, so check this to confirm a change.",
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "updated": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "customer_devices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "fields"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "updated"
                  ]
                }
              }
            }
          },
          "customer_id": {
            "type": "integer"
          },
          "application_id": {
            "type": "integer",
            "description": "The application the update changed."
          }
        }
      },
      "LegacyBulkPatchResponse": {
        "description": "One result per entry in `updates`. The route returns 200 even when an entry fails, so check each result's `ok`.",
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "application_id": {
                  "type": "integer"
                },
                "ok": {
                  "type": "boolean"
                },
                "mutations": {
                  "type": "object",
                  "additionalProperties": true
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "LegacyBulkPatchRequest": {
        "type": "object",
        "required": [
          "updates"
        ],
        "properties": {
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "application_id"
              ],
              "additionalProperties": true,
              "properties": {
                "application_id": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "LegacyOrgPatchResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LegacyEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "application_id": {
                "type": "integer"
              },
              "customer_id": {
                "type": "integer"
              },
              "mutations": {
                "$ref": "#/components/schemas/LegacyMutations"
              },
              "data": {
                "$ref": "#/components/schemas/LegacyApplicationDetail"
              }
            }
          }
        ]
      },
      "LegacyOrgPatchRequest": {
        "description": "The fields to change. Application fields go at the top level, customer fields under `customer`, and device fields under `customer_devices`, each device with its integer `id`. `status` isn't accepted here. The [requirements reference](/setup-data-preferences) lists the field names. Leap ignores keys it doesn't recognize, so read `mutations` in the response to confirm what changed.",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "customer": {
            "type": "object",
            "additionalProperties": true
          },
          "customer_devices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "PermissionError": {
        "description": "A permission error. `message` says what the key can't do.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "You do not have the required permission to perform this action"
              }
            }
          }
        }
      },
      "ApiKeyError": {
        "description": "A missing or invalid API key. Leap answers before the request reaches a route.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "No or invalid API key or JWT provided in authorization header"
          }
        }
      }
    }
  }
}

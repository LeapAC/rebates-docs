{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Leap Incentives Gateway",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A855F7",
    "dark": "#6D28D9"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0B"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index",
          "quickstart",
          "setup-data-preferences"
        ]
      },
      {
        "group": "VPP Offers",
        "pages": [
          "vpp-offers/how-offers-are-priced"
        ]
      },
      {
        "group": "Incentives",
        "openapi": "api-reference/specs/gcs-incentives.json",
        "pages": [
          "api-reference/incentives-lookups/overview",
          "api-reference/incentives-lookups/eligibility-codes",
          "POST /beta/incentives/lookups",
          "POST /beta/incentives/refreshes",
          "POST /beta/incentives/overrides"
        ]
      },
      {
        "group": "Applications",
        "openapi": "api-reference/specs/gcs-applications.json",
        "pages": [
          "api-reference/applications/overview",
          "api-reference/applications/migrating-from-alpha",
          "GET /beta/incentives/applications",
          "GET /beta/incentives/applications/customer-summary",
          "GET /beta/incentives/applications/{id}",
          "PATCH /beta/incentives/applications/{id}",
          "PATCH /beta/incentives/applications/bulk",
          {
            "group": "Attachments",
            "openapi": "api-reference/specs/gcs-applications-attachments.json",
            "pages": [
              "GET /beta/incentives/applications/attachments",
              "POST /beta/incentives/applications/attachments",
              "POST /beta/incentives/applications/attachments/commit",
              "GET /beta/incentives/applications/attachments/{id}/download",
              "DELETE /beta/incentives/applications/attachments/{id}"
            ]
          },
          {
            "group": "Requirements",
            "openapi": "api-reference/specs/gcs-fields.json",
            "pages": [
              "POST /beta/incentives/fields"
            ]
          }
        ]
      },
      {
        "group": "Programs",
        "openapi": "api-reference/specs/gcs-programs.json",
        "pages": [
          "GET /beta/incentives/programs",
          "GET /beta/incentives/programs/{program_id}",
          "GET /beta/incentives/programs/{programIdentifier}/approved-devices"
        ]
      },
      {
        "group": "Devices",
        "openapi": "api-reference/specs/gcs-devices.json",
        "pages": [
          "GET /beta/incentives/devices/search",
          {
            "group": "Saved devices",
            "pages": [
              "GET /beta/incentives/devices/saved",
              "PUT /beta/incentives/devices/saved/{device_id}",
              "DELETE /beta/incentives/devices/saved/{device_id}"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/leap_black.svg",
    "dark": "/logo/leap_white.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Log in",
        "href": "https://partner.incentives.leap.energy/sign-in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://partner.incentives.leap.energy/sign-up"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/leapdex",
      "linkedin": "https://www.linkedin.com/company/leap-dex/"
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-PF7MQ92GG6"
    }
  },
  "redirects": [
    {
      "source": "/setup-claimed-fields",
      "destination": "/setup-data-preferences",
      "permanent": true
    },
    {
      "source": "/api-reference/applications/attachments",
      "destination": "/setup-data-preferences",
      "permanent": true
    }
  ]
}

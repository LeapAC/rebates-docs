{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Incentives Gateway",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A855F7",
    "dark": "#6D28D9"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0B"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Incentives Lookups",
        "openapi": "api-reference/specs/gcs-incentives.json",
        "pages": [
          "api-reference/incentives-lookups/overview",
          "POST /v1.1/global-connect/incentives/lookups",
          "POST /v1.1/global-connect/incentives/refreshes",
          "POST /v1.1/global-connect/incentives/overrides"
        ]
      },
      {
        "group": "Applications",
        "openapi": "api-reference/specs/incentives-applications.json",
        "pages": [
          "api-reference/applications/overview",
          "GET /applications",
          "GET /applications/{application_id}",
          "PATCH /applications/{application_id}",
          {
            "group": "Attachments",
            "pages": [
              "GET /applications/attachments",
              "POST /applications/attachments",
              "POST /applications/attachments/commit",
              "GET /applications/attachments/{id}/download",
              "DELETE /applications/attachments/{id}"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/leap_black.svg",
    "dark": "/logo/leap_white.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:sean@leap.energy"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/leapdex",
      "linkedin": "https://www.linkedin.com/company/leap-dex/"
    }
  }
}